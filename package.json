{
  "name": "impeccable",
  "version": "5.2.0",
  "description": "Write flawlessly. A distraction-free Markdown word processor in the spirit of WordPerfect 5.1 for DOS.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=esm --minify --target=es2020 --outfile=docs/app.js",
    "watch": "esbuild src/main.js --bundle --format=esm --target=es2020 --outfile=docs/app.js --watch",
    "serve": "python3 -m http.server 8000 --directory docs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-markdown": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/search": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lezer/highlight": "^1.0.0",
    "marked": "^18.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
